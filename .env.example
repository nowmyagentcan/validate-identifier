# validate-identifier reads these from the environment only; it never reads a .env file.
# Set them in your shell, or in your MCP client's env settings.

# UK VAT live checks: your own HMRC Developer Hub application,
# subscribed to "Check a UK VAT number" v2.
HMRC_CLIENT_ID=
HMRC_CLIENT_SECRET=
# Sandbox credentials need the test API:
# VALIDATE_IDENTIFIER_HMRC_URL=https://test-api.service.hmrc.gov.uk

# ABN live checks: your own free GUID from abr.business.gov.au/Tools/WebServices.
ABN_LOOKUP_GUID=
